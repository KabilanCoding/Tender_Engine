# Copy to backend/.env and fill in. These are the only values the server needs before it can reach the
# database; every other option (AI model, limits, thresholds, prompts) is edited on the Settings page.

# development | production  (production refuses weak secrets and the development database URL)
ENVIRONMENT=production

# PostgreSQL created for ZYNEX. asyncpg driver; special characters in the password must be URL-encoded.
DATABASE_URL=postgresql+asyncpg://zynex:CHANGE_ME@db-host:5432/zynex

# Random string of 32+ characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Folder for uploaded documents (must be writable by the service user and included in backups)
UPLOAD_DIR=/var/lib/zynex/uploads

# Browser origin(s) of the web app, comma separated (the address users type, including https://)
CORS_ORIGINS=https://zynex.example.internal

# Only if the AI provider is switched to "nvidia" on the Settings page (off by default; sends text outside)
NVIDIA_API_KEY=
