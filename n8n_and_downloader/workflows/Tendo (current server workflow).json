    {
      "parameters": {
        "method": "POST",
        "url": "https://default213851214c984c2db030e81501e1fb.c0.environment.api.powerplatform.com:443/powerautomate/automations/direct/cu/17/workflows/f15693a837b74bdbaae49f892e33bec9/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=J_YJDchLPOx1qhmIz6cwaQZ80DcX8sYTY88AkdOlvWQ",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const s = $json; const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const ok = (s.failed || 0) === 0; const items = (s.new_tenders || []).map((t) => `<li>📄 <b>${esc(t.title)}</b><br>🏢 ${esc(t.org || 'Organisation not listed')} &nbsp;·&nbsp; 📅 ${esc(t.due)} &nbsp;·&nbsp; 📎 ${t.files} file${t.files === 1 ? '' : 's'}</li>`).join(''); const html = `<p>📢 <b>Tender Tiger · New Tender Update</b></p><p>🕘 <b>Run time:</b> ${$now.setZone('Asia/Kolkata').toFormat('d LLL yyyy, h:mm a')} IST<br>🔎 <b>New tenders found:</b> ${s.processed || 0}<br>📥 <b>Downloaded &amp; saved:</b> ${s.saved || 0}</p>` + (items ? `<p>🗂️ <b>New tenders</b></p><ol>${items}</ol>` : '') + `<p>${ok ? '🟢 <b>Status:</b> Completed successfully' : '🟠 <b>Status:</b> ' + s.failed + ' failed – will retry in the next run'}</p>`; return JSON.stringify({ html }); })() }}",
        "options": {}
      },
      "name": "Send summary to Microsoft Teams",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
