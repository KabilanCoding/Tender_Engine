    {
      "parameters": {
        "jsCode": "// every processed tender (Saved + Failed branches) arrives here\nconst rows = $input.all().map((i) => i.json);\nconst saved = rows.filter((r) => r.ok && r.status === 'done' && !r.skipped);\nconst M = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];\nconst due = (d) => {\n  if (!d) return 'Due date not given';\n  const p = String(d).slice(0, 10).split('-');\n  return 'Due ' + Number(p[2]) + ' ' + M[Number(p[1]) - 1] + ' ' + p[0];\n};\nreturn [{ json: {\n  processed: rows.length,\n  saved: saved.length,\n  failed: rows.filter((r) => !r.ok).length,\n  skipped_already_on_disk: rows.filter((r) => r.skipped).length,\n  no_documents: rows.filter((r) => r.status === 'no_documents').length,\n  new_tenders: saved.map((r) => ({\n    title: (r.tender_title || r.product_description || 'Untitled tender').slice(0, 140),\n    org: r.organization || '',\n    due: due(r.due_date),\n    files: (r.files || []).length,\n  })),\n  errors: rows.filter((r) => !r.ok).map((r) => ({ tid: r.tid, error: (r.error && r.error.message) || r.error })),\n} }];\n"
      },
      "name": "Run summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        544,
        -176
      ],
      "id": "5b396c17-de85-4c11-a887-15aaf7d3d741"
    },
    {
      "parameters": {
        "conditions": {
