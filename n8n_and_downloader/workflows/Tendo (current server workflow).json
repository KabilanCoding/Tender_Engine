      "id": "34aebc82-7071-4916-8905-4067b9b12d68",
      "name": "Get downloaded TIDs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -208,
        16
      ],
      "notes": "TIDs already downloaded and saved in Postgres."
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst all = $('Login + collect tender links').first().json.tenders || [];\nconst done = new Set((( $('Get downloaded TIDs').first().json.tids) || []).map(String));\n\nconst candidates = all.filter((t) => !t.tid || !done.has(String(t.tid)));\nconst alreadyDone = all.filter((t) => t.tid && done.has(String(t.tid))).length;\nconst maxNew = Number(cfg.maxNewPerRun) > 0 ? Number(cfg.maxNewPerRun) : 50;\nconst fresh = candidates.slice(0, maxNew);\nconst deferredByLimit = Math.max(0, candidates.length - fresh.length);\n\n// Always emit one marker item when there are no new tenders. The next IF node\n// sends it directly to the summary instead of passing it to the download loop.\nif (fresh.length === 0) {\n  return [{\n    json: {\n      noNewTenders: true,\n      found_on_dashboard: all.length,\n      already_done: alreadyDone,\n      fresh_candidates: candidates.length,\n      queued_new: 0,\n      deferred_by_limit: 0\n    }\n  }];\n}\n\nreturn fresh.map((t) => ({\n  json: {\n    noNewTenders: false,\n    tid: t.tid,\n    url: t.url,\n    found_on_dashboard: all.length,\n    already_done: alreadyDone,\n    fresh_candidates: candidates.length,\n    queued_new: fresh.length,\n    deferred_by_limit: deferredByLimit\n  }\n}));\n"
      },
