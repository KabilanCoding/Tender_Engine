              "id": "a1b2c3d4-0000-4000-8000-000000000001",
              "leftValue": "={{ ($json.saved || 0) + ($json.failed || 0) > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Anything to report?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        -176
      ],
      "id": "3a7e2efc-5b1a-4075-a868-bd23a63e80e2"
